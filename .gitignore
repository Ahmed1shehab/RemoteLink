# Dart and Flutter build output.
#
# `.dart_tool/` is regenerated by every `flutter pub get` and contains absolute
# paths from the machine that ran it, so committing it produces a diff on every
# resolution and a conflict on every merge. It also carried a 10 MB `hook.dill`
# and a compiled `.dylib` here, neither of which belongs in history.
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# The root lockfile IS committed — this is a pub workspace, so one lockfile
# describes the whole repository and pinning it is the point.
!pubspec.lock

# Platform runner scaffolding that `flutter create` regenerates.
# See tool/bootstrap_platforms.sh, which is how these are produced.
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/ios/Pods/
**/macos/Pods/
**/ios/.symlinks/
**/macos/.symlinks/

# Xcode and Android local state.
**/xcuserdata/
**/*.xcworkspace/xcuserdata/
**/android/local.properties
**/android/.gradle/
**/android/key.properties
*.jks
*.keystore

# IDE.
*.iml
.idea/
.vscode/*
!.vscode/launch.json
.claude/

# OS.
.DS_Store
Thumbs.db

# Coverage and profiling output.
coverage/
*.lcov

# Latency harness results — measurements are machine- and network-specific,
# so a committed baseline would be misleading rather than useful. Publish
# numbers in docs/PERFORMANCE.md with their conditions instead.
*.latency.json
