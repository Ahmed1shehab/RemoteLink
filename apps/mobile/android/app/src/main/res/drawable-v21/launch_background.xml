<?xml version="1.0" encoding="utf-8"?>
<!-- The first frame of the app, drawn by Android before the Flutter engine has
     started. Without the mark it is a blank page for as long as a cold start
     takes, which on a mid-range phone is long enough to look like nothing
     happened. The background follows the system's light or dark setting, so the splash does not flash white on the way into a dark app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/launch_image" />
    </item>
</layer-list>
