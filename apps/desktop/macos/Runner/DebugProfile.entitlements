<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Sandbox. Matched to Release deliberately: the sandbox changes
	     where `~/Library` resolves to, so a debug build that had it would put
	     its login item and its application support somewhere the release build
	     never looks — and the bug would only ever appear in the build nobody
	     runs under a debugger. The reasoning is in Release.entitlements. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Under the hardened runtime, the Info.plist usage string alone is not
	     enough: an app also needs this entitlement before it may send an Apple
	     event at all. Both halves are required, which is why one without the
	     other looks like the permission "not working". It buys the now-playing
	     title and nothing else. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
