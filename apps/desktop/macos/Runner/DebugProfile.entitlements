<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Writing received files to ~/Downloads/RemoteLink. Without it the
	     directory cannot even be created, and the failure surfaces on the
	     sender's phone as an abort — for a long time as "not enough storage
	     space", which was the receiver mapping every storage failure to one
	     cause. The container's Downloads is a symlink to the real folder, so
	     the path resolves and reads fine; only the write is refused. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- Reading a file the user chose in the open dialog, or dropped on the
	     window. The app is sandboxed, so without this the dialog still opens and
	     the selection still comes back — and every read of it fails. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
