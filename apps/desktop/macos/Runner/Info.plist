<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<false/>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<!-- Shown when macOS asks about the Downloads folder. Needed now that the
	     app is not sandboxed: inside a sandbox the entitlement covered this, and
	     outside one it is TCC's question instead. Without a string here the
	     prompt is generic, and on recent macOS an app that cannot explain itself
	     is simply refused — which would surface on the sending phone as a
	     transfer that aborts for no stated reason. -->
	<!-- Required before this app may send a single Apple event, and its absence
	     is what silently broke media metadata. Reading the current track from
	     Spotify, Music, or a browser tab is an Apple event; since macOS 10.14
	     an app without this string is refused outright, and the refusal arrives
	     as an ordinary non-zero exit from `osascript` — so the desktop reported
	     "nothing playing" while a song was audibly playing, and the phone had
	     no way to know the difference. Volume and the transport keys do not go
	     through here: they use CoreAudio and synthesised HID events, which is
	     why those keep working with this permission denied. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Remote Link asks your music player or browser what is playing, so your phone can show the track and control it.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Remote Link saves the files your phone sends into your Downloads folder.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Remote Link lets your phone find and control this computer over your local network.</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
